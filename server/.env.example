# Replace with your own PostgreSQL user, password, hostname, port, and database name.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/toktickit?schema=public"
PORT=3000

# Origin(s) the CSRF Origin/Referer check (BR-L3-09) accepts on mutating
# session-protected requests. Comma-separated for multiple allowed origins.
APP_ORIGIN=http://localhost:5173
